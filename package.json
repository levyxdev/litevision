    "mcp",
    "mcp-server",
    "image-generation",
    "ai-agent",
    "claude-code",
    "openai",
    "gemini",
    "venice",
    "apimart"
  ],
  "homepage": "https://github.com/levyxdev/litevision#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levyxdev/litevision.git"
  },
  "bugs": "https://github.com/levyxdev/litevision/issues",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "litevision": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
